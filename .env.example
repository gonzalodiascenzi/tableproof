# valores reales solo en .env (no se commitea). no completar acá.
# copiá este archivo a .env y completá los valores. `python -m engine.check ventures/<slug>` te dice cuáles faltan.

# --- whatsapp cloud api (docs/whatsapp-local.md) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# --- mercado pago (docs/mercadopago-verificado.md) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MODE=test

# --- entrega por descarga (solo si el producto es kind: download): cadena larga al azar que inventás vos ---
DELIVERY_SECRET=

# --- anuncios: imágenes con gemini (docs/ads-verificado.md) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
# opcional: generate_content (por defecto) o interactions
GEMINI_IMAGE_API=

# --- anuncios: meta ads (docs/ads-verificado.md) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_API_VERSION=

# --- producto de ventures/chatbots-saas (ventures/chatbots-saas/producto/README.md) ---
ANTHROPIC_API_KEY=
# url del /verify del servidor de venta, por ejemplo https://<dominio>/verify
TABLEPROOF_VERIFY_URL=
# consultas que vale cada clave paga: lo definís vos, no tiene valor por defecto
CHATBOT_PACK_MESSAGES=
# opcional: modelo de claude (por defecto, el de producto/bot.py)
CHATBOT_MODEL=

# --- servidor (opcionales) ---
# HOST=0.0.0.0
# PORT=8080
# DB_PATH=tableproof.sqlite
